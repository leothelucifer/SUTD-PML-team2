+def _stay_summary(frame: pd.DataFrame, score: str, threshold: float, cooldown: int) -> np.ndarray:
+    """Per stay: TP, FP, FN and TN hours, the three utility sums, false alert events and non-septic hours.
+
+    False alert events use the cooldown and count only stays with no septic-labelled hour, as
+    ``policy.summarize`` does. Every subgroup metric is a ratio of sums of these columns.
+    """
+    values = frame[score].to_numpy(dtype=float)
+    labels = frame["label"].to_numpy(dtype=int)
+    hours = frame["hour"].to_numpy(dtype=float)
+    _, stays = _stay_slices(frame)
+    burden = np.zeros((len(stays), 2))
+    for index, rows in enumerate(stays):
+        if not labels[rows].any():
+            burden[index] = (alert_events(hours[rows], values[rows], threshold, cooldown).sum(), len(rows))
+    return np.hstack([_patient_counts(frame, score, threshold), _stay_utilities(frame, values >= threshold), burden])
+
+
+def _summaries(sums: np.ndarray) -> dict[str, np.ndarray]:
+    """The subgroup metrics from ``_stay_summary`` sums (rows are groups or bootstrap draws).
+
+    Recall is NaN where there is no septic-labelled hour, so a resample that drew no septic stay
+    for a group is left out of that group's interval instead of counting as recall 0.
+    """
+    rates = _rates(sums[..., :4])
+    positives = sums[..., 0] + sums[..., 2]
+    rates["recall"] = np.where(positives > 0, rates["recall"], np.nan)
+    rates["utility"] = _utility(sums[..., 4:7])
+    events, hours = sums[..., 7], sums[..., 8]
+    rates["false_alerts_per_day"] = np.divide(events * 24, hours, out=np.full(np.shape(hours), np.nan), where=hours > 0)
+    return rates
+
+
+def stay_attributes(frame: pd.DataFrame) -> dict[str, tuple[np.ndarray, list[str]]]:
+    """Recorded sex and age band of every stay, in the stay order of ``_stay_summary``.
+
+    Bands and labels are the monitoring ones, so the report and the drift checks agree.
+    """
+    stays = frame.groupby("patient_id", sort=False).agg(age=("Age", "first"), gender=("Gender", "first"))
+    bands = pd.cut(stays["age"], AGE_BINS, labels=AGE_LABELS, right=False).astype(object)
+    return {"sex": (stays["gender"].map(GENDER_LABELS).to_numpy(dtype=object), list(GENDER_LABELS.values())),
+            "age_band": (bands.to_numpy(dtype=object), list(AGE_LABELS))}
+
+
+def subgroup_table(frame: pd.DataFrame, score: str, threshold: float, cooldown: int,
+                   groups: dict[str, tuple[np.ndarray, list[str]]], *, scope: str, draws: int = 200, seed: int = 42,
+                   min_septic_stays: int = 10, include_all: bool = True) -> pd.DataFrame:
+    """One row per group, plus the largest gap per attribute, with stay-grouped bootstrap intervals.
+
+    ``groups`` maps an attribute to (its value for every stay, the group names in display order).
+    A group with fewer than ``min_septic_stays`` septic stays, or with no non-septic stay, is counted
+    but not scored. Each resample draws whole stays from the full cohort, so group sizes vary between
+    draws as they would in a new sample. The gap is the best group minus the worst.
+    """
+    sums = _stay_summary(frame, score, threshold, cooldown)
+    septic = (sums[:, 0] + sums[:, 2]) > 0
+    hours = sums[:, :4].sum(axis=1)
+    weights = _resample_weights(len(sums), draws, seed) if draws > 0 else None
+
+    def describe(mask: np.ndarray, attribute: str, group: str, minimum: int = min_septic_stays) -> tuple[dict, dict | None]:
+        stays, septic_stays = int(mask.sum()), int(septic[mask].sum())
+        row = {"scope": scope, "attribute": attribute, "group": group, "stays": stays, "septic_stays": septic_stays,
+               "hours": int(hours[mask].sum()), "sufficient": septic_stays >= minimum and stays > septic_stays}
+        if not row["sufficient"]:
+            return row, None
+        point = _summaries(sums[mask].sum(axis=0))
+        resampled = _summaries(weights[:, mask] @ sums[mask]) if weights is not None else None
+        for metric in SUBGROUP_METRICS:
+            value = float(point[metric])
+            row[metric] = None if np.isnan(value) else value
+            if resampled is not None:
+                row[f"{metric}_ci_low"], row[f"{metric}_ci_high"] = _interval(resampled[metric])
+        return row, {"point": point, "resampled": resampled}
+
+    # The whole cohort is the reference row, so it is scored whenever it has both kinds of stay.
+    rows = [describe(np.ones(len(sums), dtype=bool), "all", "all stays", minimum=1)[0]] if include_all else []
+    for attribute, (values, names) in groups.items():
+        scored = []
+        for name in names:
+            row, detail = describe(np.asarray(values, dtype=object) == name, attribute, name)
+            rows.append(row)
+            if detail is not None:
+                scored.append(detail)
+        if len(scored) < 2:
+            continue
+        gap = {"scope": scope, "attribute": attribute, "group": GAP_GROUP, "sufficient": True}
+        for metric in GAP_METRICS:
+            points = np.array([float(detail["point"][metric]) for detail in scored])
+            gap[metric] = float(np.nanmax(points) - np.nanmin(points)) if not np.isnan(points).all() else None
+            if weights is not None:
+                stacked = np.vstack([detail["resampled"][metric] for detail in scored])
+                with warnings.catch_warnings():
+                    warnings.simplefilter("ignore", RuntimeWarning)  # a draw where no group has a value
+                    spread = np.nanmax(stacked, axis=0) - np.nanmin(stacked, axis=0)
+                gap[f"{metric}_ci_low"], gap[f"{metric}_ci_high"] = _interval(spread)
+        rows.append(gap)
+    return pd.DataFrame(rows).reindex(columns=SUBGROUP_TABLE_COLUMNS)
+
+
+def subgroup_markdown(table: pd.DataFrame, model: str, threshold: float, min_septic_stays: int, where: str) -> str:
+    """The subgroup table as Markdown, with what it does not cover."""
+    def cell(row, metric):
+        value = row.get(metric)
+        if value is None or pd.isna(value):
+            return ""
+        low, high = row.get(f"{metric}_ci_low"), row.get(f"{metric}_ci_high")
+        return _fmt(value) + ("" if low is None or pd.isna(low) else f" ({_fmt(low)}-{_fmt(high)})")
+
+    lines = ["| Scope | Attribute | Group | Stays | Septic stays | Recall | Precision | Hourly utility | False alerts / non-septic patient-day |",
+             "|---|---|---|---:|---:|---:|---:|---:|---:|"]
+    for _, row in table.iterrows():
+        if row["group"] == GAP_GROUP:
+            lines.append(f"| {row['scope']} | {row['attribute']} | *{GAP_GROUP}* | | | {cell(row, 'recall')} | | "
+                         f"{cell(row, 'utility')} | |")
+            continue
+        counts = f"{int(row['stays']):,} | {int(row['septic_stays']):,}"
+        if not row["sufficient"]:
+            lines.append(f"| {row['scope']} | {row['attribute']} | {row['group']} | {counts} | "
+                         f"not scored (fewer than {min_septic_stays} septic stays) | | | |")
+            continue
+        lines.append(f"| {row['scope']} | {row['attribute']} | {row['group']} | {counts} | {cell(row, 'recall')} | "
+                     f"{cell(row, 'precision')} | {cell(row, 'utility')} | {cell(row, 'false_alerts_per_day')} |")
+    lines += ["", f"{model} at its frozen threshold {_fmt(threshold, 2)}, {where}. Hourly decisions; brackets are 95% "
+              "intervals from resampling whole stays. The gap is the best group minus the worst; with several groups "
+              "it is pushed upward by chance, so read it with its interval. A gap whose interval is wide means the "
+              "data cannot tell the groups apart, not that they are equal.", "",
+              "Not checked: attributes the dataset does not record (ethnicity, language, insurance, admission "
+              "diagnosis); combinations of attributes (for example women aged 80+); gender is recorded as two values "
+              "only. Differences in how often each group is measured are not separated from differences in the model."]
+    return "\n".join(lines) + "\n"
+
