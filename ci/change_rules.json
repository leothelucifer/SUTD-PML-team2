{
  "_about": "One source of truth for 'what does this change need?'. Used by CI (scripts/ci_changes.py) to pick the checks and by the deploy planner (scripts/deploy_plan.py) to pick the AWS stages. Files are matched in order and the first rule wins; patterns are fnmatch globs where * also matches /. A file that matches nothing is category 'other' and runs the unit tests (the safe default).",
  "rules": [
    {"category": "workflows", "patterns": [".github/*"]},
    {"category": "ci", "patterns": ["ci/*", "scripts/ci_changes.py", "scripts/deploy_plan.py"]},
    {"category": "image", "patterns": ["Dockerfile", ".dockerignore", "scripts/docker_smoke_test.sh"]},
    {"category": "dependencies", "patterns": ["requirements/*", "requirements.txt", "pyproject.toml", "uv.lock", "scripts/lock_requirements.sh"]},
    {"category": "infra", "patterns": ["infra/*", "scripts/aws_*", "scripts/bootstrap_github_oidc.sh", "scripts/sagemaker_train.py"]},
    {"category": "features", "patterns": ["src/sepsis_warning/features.py", "src/sepsis_warning/schema.py", "src/sepsis_warning/signature.py", "src/sepsis_warning/policy.py"]},
    {"category": "tools", "patterns": ["src/sepsis_warning/mlflow_server.py", "src/sepsis_warning/evidently_*.py", "src/sepsis_warning/tracking.py"]},
    {"category": "serving", "patterns": [
      "src/sepsis_warning/api.py", "src/sepsis_warning/service.py", "src/sepsis_warning/lambda_app.py", "src/sepsis_warning/alert_store.py",
      "src/sepsis_warning/client.py", "src/sepsis_warning/model_source.py", "src/sepsis_warning/telemetry.py", "src/sepsis_warning/gates.py",
      "src/sepsis_warning/live_drift.py", "src/sepsis_warning/drift_handler.py", "src/sepsis_warning/prediction_log.py",
      "src/sepsis_warning/manifest.py", "src/sepsis_warning/scoring.py", "src/sepsis_warning/monitoring.py", "src/sepsis_warning/ward.py",
      "src/sepsis_warning/ward_template.html", "scripts/call_scoring_url.py", "scripts/latency.py"]},
    {"category": "training", "patterns": ["src/*", "dvc.yaml", "dvc.lock", "scripts/download_data.py", "scripts/fit_hmm.py", "scripts/h03_ablation.py", "scripts/causal_features.py"]},
    {"category": "notebooks", "patterns": ["*.ipynb", "scripts/check_notebooks.py"]},
    {"category": "tests", "patterns": ["tests/*"]},
    {"category": "docs", "patterns": ["docs/*", "*.md", "reports/*", "*.patch", "artifacts/*", "data/*"]}
  ],
  "categories": {
    "workflows": {"ci": ["workflows"], "deploy": []},
    "ci": {"ci": ["unit", "workflows"], "deploy": []},
    "image": {"ci": ["unit", "docker"], "deploy": ["stack", "serve"]},
    "dependencies": {"ci": ["unit", "docker", "audit"], "deploy": ["stack", "serve"]},
    "infra": {"ci": ["unit", "cloudformation"], "deploy": ["stack"]},
    "features": {"ci": ["unit", "docker"], "deploy": ["retrain", "serve"]},
    "tools": {"ci": ["unit", "docker"], "deploy": ["stack"]},
    "serving": {"ci": ["unit", "docker"], "deploy": ["serve"]},
    "training": {"ci": ["unit", "docker"], "deploy": ["retrain"]},
    "notebooks": {"ci": ["unit"], "deploy": []},
    "tests": {"ci": ["unit"], "deploy": []},
    "docs": {"ci": [], "deploy": []},
    "other": {"ci": ["unit"], "deploy": []}
  },
  "all_ci_jobs": ["unit", "docker", "cloudformation", "audit", "workflows"],
  "all_deploy_stages": ["stack", "retrain", "serve"]
}
